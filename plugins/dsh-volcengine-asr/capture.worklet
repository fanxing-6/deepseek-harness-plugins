class PcmCapture extends AudioWorkletProcessor {
  constructor() {
    super();
    this.buffer = new ArrayBuffer(6400);
    this.view = new DataView(this.buffer);
    this.length = 0;
    this.energy = 0;
    this.active = true;
    this.port.onmessage = event => {
      if (event.data === 'finish') {
        this.active = false;
        this.flush();
        this.port.postMessage({ type: 'finished' });
      }
    };
  }
  flush() {
    if (!this.length) return;
    const bytes = this.buffer.slice(0, this.length * 2);
    this.port.postMessage({ type: 'audio', bytes, level: Math.sqrt(this.energy / this.length) }, [bytes]);
    this.length = 0;
    this.energy = 0;
  }
  process(inputs) {
    if (!this.active) return false;
    const samples = inputs[0]?.[0];
    if (!samples) return true;
    for (const value of samples) {
      const sample = Math.max(-1, Math.min(1, value));
      this.view.setInt16(this.length * 2, Math.round(sample * (sample < 0 ? 32768 : 32767)), true);
      this.energy += sample * sample;
      if (++this.length === 3200) this.flush();
    }
    return true;
  }
}
registerProcessor('dsh-volc-pcm', PcmCapture);
